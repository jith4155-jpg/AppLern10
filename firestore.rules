rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidAppSettings(data) {
      return data.upiId is string && data.upiId.size() <= 128 &&
             data.payeeName is string && data.payeeName.size() <= 128 &&
             (data.qrImageUrl == null || (data.qrImageUrl is string && data.qrImageUrl.size() <= 2048)) &&
             data.whatsappGroupLink is string && data.whatsappGroupLink.size() <= 1024 &&
             data.emergencyContact is string && data.emergencyContact.size() <= 128 &&
             data.coursePrice is number && data.coursePrice >= 0;
    }

    function isValidLearner(data) {
      return data.email is string &&
             data.isPaid is bool;
    }

    function isValidPayment(data) {
      return data.userEmail is string &&
             data.amount is number;
    }

    // --- Match Blocks ---

    // App Config
    match /settings/app-config {
      allow read: if true; // Publicly readable
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Admins
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Users
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Payments
    match /payments/{paymentId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Counters
    match /counters/{counterId} {
      allow read, create, update: if isSignedIn();
    }
  }
}
